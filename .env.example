APP_NAME=SchoolCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ─── Session & Cache ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ─────────────────────────────────────────────────────────────────────
# "log" writes emails to storage/logs. Set MAIL_MAILER=brevo (and BREVO_API_KEY)
# to really send invitations, password resets and appointment emails.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@iccbiclinic.site"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=false
TRUST_PROXIES=*

# ─── Third-party API Keys ─────────────────────────────────────────────────────
GROQ_API_KEY=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SCHOOLCARE

# ─── First administrator (created once, only if no administrator exists) ──────
# Leave ADMIN_PASSWORD empty to have a random password generated and printed
# in the deploy log. Change it after the first login.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
