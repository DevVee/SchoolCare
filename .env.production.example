# SSCMS production environment template
# Copy to .env.production (git-ignored) and fill in the blanks.

APP_NAME=SSCMS
APP_ENV=production
APP_DEBUG=false
# Generate once: php artisan key:generate --show   (keep it stable!)
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# true when served over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Behind a reverse proxy / load balancer
TRUST_PROXIES=*
ALLOW_REGISTRATION=false
BCRYPT_ROUNDS=12

# ─── First administrator (created once, only if none exists) ──────────────────
# Leave ADMIN_PASSWORD empty to generate one (printed once in `docker compose logs`).
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Email (password resets, notifications) ───────────────────────────────────
# "log" writes emails to the log instead of sending them.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ─── SMS (Semaphore) ──────────────────────────────────────────────────────────
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=CLINOVIA

# ─── AI assistant (Groq) ──────────────────────────────────────────────────────
GROQ_API_KEY=
