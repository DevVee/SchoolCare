# SchoolCare production environment template
# Copy to .env.production (git-ignored) and fill in the blanks.

APP_NAME=SchoolCare
APP_ENV=production
APP_DEBUG=false
# Generate once: php artisan key:generate --show   (keep it stable!)
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# true when served over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Behind a reverse proxy / load balancer
TRUST_PROXIES=*
ALLOW_REGISTRATION=false
BCRYPT_ROUNDS=12

# ─── First administrator (created once, only if none exists) ──────────────────
# Leave ADMIN_PASSWORD empty to generate one (printed once in `docker compose logs`).
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Email (invitations, password resets, notifications) ──────────────────────
# Sent through the Brevo HTTP API. The sender domain must be authenticated in
# Brevo (Senders, Domains & Dedicated IPs). "log" writes emails to the log instead.
# MAIL_FROM_ADDRESS must be on that authenticated domain (after a domain move,
# authenticate the new one first). If Brevo limits API keys to authorised IP
# addresses, add this server's IP there. `php artisan mail:check` shows what is
# wrong and the latest failures (also Actions > Maintenance > mail).
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@schoolcare.online"
MAIL_FROM_NAME="${APP_NAME}"

# ─── SMS (Semaphore) ──────────────────────────────────────────────────────────
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SchoolCare

# ─── AI assistant (Groq) ──────────────────────────────────────────────────────
GROQ_API_KEY=
